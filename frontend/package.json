{
  "name": "gyverlamp2-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check src tests *.ts *.json",
    "format": "prettier --write src tests *.ts *.json",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
